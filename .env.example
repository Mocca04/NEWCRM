# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# ── Base de datos (fase 1) ──
# Usuario propietario del esquema. El backend baja al rol app_rls en cada
# transaccion de empresa; no necesita otro usuario.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newcrm
# Base vacia que Prisma usa para calcular migraciones en desarrollo.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newcrm_shadow

# ── Colas (fase 2 en adelante) ──
REDIS_URL=redis://localhost:6379

# ── API (fase 2) ── estas variables van en apps/api/.env
PORT=3001
# Origenes web autorizados a llamar la API, separados por coma.
CORS_ORIGINS=http://localhost:3000
# Dias de prueba al registrar una empresa.
DEFAULT_TRIAL_DAYS=14

# ── Autenticacion: Supabase (fase 2) ──
# URL del proyecto. La API valida las sesiones con las llaves publicas del
# proyecto; no necesita ninguna llave secreta de Supabase.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Solo si el proyecto es antiguo y firma sesiones con HS256. Si no, dejar vacio.
SUPABASE_JWT_SECRET=
# Para la aplicacion web (llave publica, se puede exponer en el navegador).
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Web (fase 2) ── estas variables van en apps/web/.env.local
# Donde esta la API, vista desde el servidor de la web.
API_URL=http://localhost:3001
# Direccion publica de la web; se usa en el enlace de confirmacion de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Archivos: almacenamiento compatible con S3 (fase 3) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Correo transaccional (fase 5) ──
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ── Apple Wallet (etapa 2) ── sin estos valores se usa el adaptador de pruebas
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# ── Google Wallet (etapa 2) ── sin estos valores se usa el adaptador de pruebas
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# ── Wompi: cobro de suscripciones de la plataforma (etapa 2) ──
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# ── WhatsApp Business Platform (etapa 3) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Cifrado de llaves de pasarela de cada establecimiento (etapa 3) ──
FIELD_ENCRYPTION_KEY=
