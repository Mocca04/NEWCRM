# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# ── Base de datos (fase 1) ──
# Usuario propietario del esquema. El backend baja al rol app_rls en cada
# transaccion de empresa; no necesita otro usuario.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newcrm
# Base vacia que Prisma usa para calcular migraciones en desarrollo.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newcrm_shadow

# ── Colas (fase 2 en adelante) ──
REDIS_URL=redis://localhost:6379

# ── Autenticacion: Supabase (fase 2) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Archivos: almacenamiento compatible con S3 (fase 3) ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Correo transaccional (fase 5) ──
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ── Apple Wallet (etapa 2) ── sin estos valores se usa el adaptador de pruebas
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_BASE64=

# ── Google Wallet (etapa 2) ── sin estos valores se usa el adaptador de pruebas
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# ── Wompi: cobro de suscripciones de la plataforma (etapa 2) ──
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# ── WhatsApp Business Platform (etapa 3) ──
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Cifrado de llaves de pasarela de cada establecimiento (etapa 3) ──
FIELD_ENCRYPTION_KEY=
